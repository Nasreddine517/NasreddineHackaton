{
  "name": "kenza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:worker": "tsx watch apps/worker/src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build --config apps/web/vite.config.ts && tsup --config tsup.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx packages/core/src/db/cli.ts migrate",
    "db:seed": "tsx packages/core/src/db/cli.ts seed",
    "check": "pnpm typecheck && pnpm test",
    "models:check": "tsx scripts/check-models.ts",
    "merchant:setup": "tsx scripts/setup-merchant.ts",
    "agents:check": "tsx scripts/check-agents.ts"
  },
  "dependencies": {
    "@fastify/websocket": "11.2.0",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "bullmq": "6.3.6",
    "csv-parse": "7.0.2",
    "dotenv": "16.6.1",
    "fastify": "5.12.5",
    "ioredis": "5.7.0",
    "lucide-react": "0.468.0",
    "openai": "7.17.0",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@types/node": "20.19.9",
    "@types/pg": "8.15.5",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "6.4.3"
  }
}
