# Copy to .env. Never commit .env or actual credentials.
WEB_PORT=8080
POSTGRES_DB=kenza
POSTGRES_USER=kenza
POSTGRES_PASSWORD=kenza_local_only
POSTGRES_HOST_PORT=15432
# For host-side development only; Compose uses internal service addresses.
DATABASE_URL=postgresql://kenza:kenza_local_only@localhost:15432/kenza
REDIS_URL=redis://localhost:6379
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info
# Set these locally when implementing the merchant login.
MERCHANT_EMAIL=
MERCHANT_PASSWORD=
SESSION_SECRET=
# Server-side LLM access. Exact values are supplied by the organizer.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
# Separate Azure deployment for GPT-4.1; use the exact values from the email.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1
AZURE_OPENAI_MAX_TOKENS=16384
# Embedding deployment on the primary endpoint unless a separate access is supplied.
EMBEDDING_MODEL=embedder-small-3
EMBEDDING_DIMENSIONS=512
EMBEDDING_URL=
EMBEDDING_API_KEY=
FOLLOWUP_DELAY_MS=1800000
DEMO_MODE=false
