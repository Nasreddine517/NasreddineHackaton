# Copy to .env. Never commit .env or actual credentials.
WEB_PORT=8080
POSTGRES_DB=kenza
POSTGRES_USER=kenza
POSTGRES_PASSWORD=kenza_local_only
# For host-side development only; Compose uses internal service addresses.
DATABASE_URL=postgresql://kenza:kenza_local_only@localhost:5432/kenza
REDIS_URL=redis://localhost:6379
API_PORT=3000
API_HOST=127.0.0.1
LOG_LEVEL=info
# Set these locally when implementing the merchant login.
MERCHANT_EMAIL=
MERCHANT_PASSWORD=
SESSION_SECRET=
# Server-side LLM access. Exact values are supplied by the organizer.
LLM_URL=
LLM_API_KEY=
LLM_MODEL=
SECONDARY_LLM_URL=
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_MODEL=
FOLLOWUP_DELAY_MS=1800000
DEMO_MODE=false
